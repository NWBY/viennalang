---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Vienna - Experimental Programming Language" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Vienna is an experimental programming language" />
    <title>{title}</title>
  </head>
  <body class="bg-neutral-950">
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
